                {
                  "vendor_id": 1278,
                  "product_id": 22,
                  "is_keyboard": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "バックスラッシュでビューアを閉じる(CoverZip)",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.dmng\\.CoverZip$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "description": "CoverZip Backslash to Cmd-w",
          "from": {
            "key_code": "backslash"
          },
          "to": [
            {
              "key_code": "w",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "チルダでビューアを閉じる(CoverZip)",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.dmng\\.CoverZip$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "description": "CoverZip Tilde to Cmd-w",
          "from": {
            "key_code": "grave_accent_and_tilde"
          },
          "to": [
            {
              "key_code": "w",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "HHKB Studio: CoverZipの文字入力欄以外で矢印キーへ変換",
