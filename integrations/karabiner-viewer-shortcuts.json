{
  "title": "CoverZipとFinderのショートカット分担",
  "rules": [
    {
      "description": "Quick Look: 閉じるキーとHHKB限定の矢印キー変換",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "semicolon"
          },
          "to": [
            {
              "key_code": "left_arrow"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.role_string",
              "value": "AXWindow"
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.subrole_string",
              "value": "Quick Look"
            },
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 22,
                  "is_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "quote"
          },
          "to": [
            {
              "key_code": "right_arrow"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.role_string",
              "value": "AXWindow"
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.subrole_string",
              "value": "Quick Look"
            },
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 22,
                  "is_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "grave_accent_and_tilde"
          },
          "to": [
            {
              "key_code": "escape",
              "repeat": false
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.role_string",
              "value": "AXWindow"
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.subrole_string",
              "value": "Quick Look"
            }
          ],
          "to_after_key_up": [
            {
              "software_function": {
                "open_application": {
                  "bundle_identifier": "com.apple.finder"
                }
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "backslash"
          },
          "to": [
            {
              "key_code": "escape",
              "repeat": false
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.role_string",
              "value": "AXWindow"
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.subrole_string",
              "value": "Quick Look"
            }
          ],
          "to_after_key_up": [
            {
              "software_function": {
                "open_application": {
                  "bundle_identifier": "com.apple.finder"
                }
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "open_bracket"
          },
          "to": [
            {
              "key_code": "up_arrow"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ]
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.role_string",
              "value": "AXWindow"
            },
            {
              "type": "variable_if",
              "name": "accessibility.focused_ui_element.subrole_string",
              "value": "Quick Look"
            },
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 22,
                  "is_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "slash"
          },
          "to": [
            {
              "key_code": "down_arrow"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
